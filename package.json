{
  "name": "skydial",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A refined cross-platform PWA tracking the position, rise/set and twilight of the sun and moon (sun path & moon tracker)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/user-event": "^14.6.10",
    "@types/leaflet": "^1.9.22",
    "@types/three": "^0.187.0",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^31.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "^5.0.0",
    "wrangler": "^4.162.0"
  }
}
