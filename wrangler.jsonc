/**
 * Skydial — Cloudflare Workers (static assets only)
 * https://developers.cloudflare.com/workers/static-assets/
 *
 * The build output is purely static files, so there is no Worker script (main).
 * Security headers from public/_headers, copied into dist, take effect as is
 * (Workers static assets interprets _headers).
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skydial",
  "compatibility_date": "2026-08-11",
  "assets": {
    "directory": "./dist",
    // Vercel also served plain static files without rewrites, so unknown paths stay
    // 404 to match (all state lives in query parameters, so no SPA routing is needed).
    "not_found_handling": "404-page",
  },
  "observability": {
    "enabled": true,
  },
}
